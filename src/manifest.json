{
  "manifest_version": 3,
  "name": "Hearline — Listen to any webpage",
  "version": "1.2.0",
  "description": "Hearline reads any webpage, article or blog out loud with real-time word highlighting. Free, private, no account.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hearline",
    "default_icon": "icons/icon128.png",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-hearline": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "Start or stop Hearline on this page"
    },
    "read-selection": {
      "description": "Read the selected text"
    }
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
